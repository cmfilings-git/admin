        <a href="/modules/crm/compliance.html" class="flex flex-col items-center justify-center w-full h-full text-app-blue"><svg class="w-7 h-7 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.1a2.25 2.25 0 00-2-2.2M8.25 8.25H4.875A1.125 1.125 0 003.75 9.375v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375A1.125 1.125 0 0013.5 8.25H8.25z"/></svg><span class="text-xs font-bold">Compliance</span></a>
        <a href="/modules/crm/credentials.html" class="flex flex-col items-center justify-center w-full h-full text-gray-400"><svg class="w-7 h-7 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622"/></svg><span class="text-xs font-medium">Credentials</span></a>
        <a href="/module/accounts/transactions.html" class="flex flex-col items-center justify-center w-full h-full text-gray-400"><svg class="w-7 h-7 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9"/></svg><span class="text-xs font-medium">Transactions</span></a>
      </div>
    </nav>
  </div>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import {
      getAuth, onAuthStateChanged, signInWithEmailAndPassword, signOut
    } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
    import {
      getFirestore, collection, getDocs
    } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyAY0eJ0iAVxP2tn2RLe7wVNB8Q15Vnjd-g",
      authDomain: "cmb-40001.firebaseapp.com",
      projectId: "cmb-40001",
      storageBucket: "cmb-40001.firebasestorage.app",
      messagingSenderId: "294144253040",
      appId: "1:294144253040:web:852b7c378ee8049f4268b5",
      measurementId: "G-RX05KNR8Y3"
    };

    const ALLOWED_ADMIN_EMAIL = "shanicm@gmail.com";
    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);

    const $ = (id) => document.getElementById(id);
    let allRecords = [];
    let clientIds = new Set();

    function showAuthError(message) {
      $("authError").textContent = message;
      $("authError").classList.remove("hidden");
    }

    function normalize(value) {
      return String(value ?? "").trim().toLowerCase();
    }

    function toDate(value) {
      if (!value) return null;
      if (typeof value?.toDate === "function") return value.toDate();
      if (typeof value === "object" && value.seconds) return new Date(value.seconds * 1000);
      if (typeof value === "string") {
        const raw = value.trim();
        if (!raw) return null;
        // Supports ISO dates and common dd-mm-yyyy / dd/mm/yyyy formats.
        const dmy = raw.match(/^(\d{1,2})[-/](\d{1,2})[-/](\d{4})$/);
        if (dmy) return new Date(Number(dmy[3]), Number(dmy[2]) - 1, Number(dmy[1]));
        const parsed = new Date(raw);
        return Number.isNaN(parsed.getTime()) ? null : parsed;
      }
      return null;
    }

    function filed(record) {
      const status = normalize(record.complianceStatus);
      return Boolean(record.filedAt) || ["filed", "completed", "complete", "done", "submitted"].includes(status);
    }

    function recordStatus(record) {
      if (filed(record)) return "completed";
      const due = toDate(record.dueDate);
      if (due) {
        const today = new Date(); today.setHours(0,0,0,0);
        due.setHours(0,0,0,0);
        if (due < today) return "overdue";
      }
      return "pending";
    }

    function formatDate(value) {
      const date = toDate(value);
      return date ? new Intl.DateTimeFormat("en-IN", { day:"2-digit", month:"short", year:"numeric" }).format(date) : (value ? String(value) : "—");
    }

    function escapeHtml(value) {
      return String(value ?? "").replace(/[&<>"']/g, c => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" }[c]));
    }

    function pill(status) {
      const labels = { completed:"Completed", pending:"Pending", overdue:"Overdue" };
      const cls = { completed:"status-complete", pending:"status-pending", overdue:"status-overdue" };
      return `<span class="status-pill ${cls[status] || "status-other"}">${labels[status] || escapeHtml(status || "Unknown")}</span>`;
    }

    function paymentPill(value) {
      const v = normalize(value);
      const cls = v === "paid" ? "status-complete" : (v === "unpaid" || v === "pending" ? "status-pending" : "status-other");
      return `<span class="status-pill ${cls}">${escapeHtml(value || "—")}</span>`;
    }

    function render() {
      const query = normalize($("searchInput").value);
      const statusFilter = $("statusFilter").value;
      const periodFilter = $("periodFilter").value;
      const paymentFilter = $("paymentFilter").value;

      const filtered = allRecords.filter(r => {
        const status = recordStatus(r);
        const searchText = [r.clientName, r.clientId, r.complianceId, r.complianceName, r.CompliancePeriod, r.complianceAknNumber].map(normalize).join(" ");
        return (!query || searchText.includes(query))
          && (!statusFilter || status === statusFilter)
          && (!periodFilter || String(r.CompliancePeriod ?? "") === periodFilter)
          && (!paymentFilter || normalize(r.paymentStatus) === paymentFilter);
      });

      $("recordCount").textContent = `${filtered.length} of ${allRecords.length} records`;
      $("emptyState").classList.toggle("hidden", filtered.length !== 0);
      $("complianceRows").innerHTML = filtered.map(r => {
        const status = recordStatus(r);
        const folder = r.taskFolderLink ? `<a href="${escapeHtml(r.taskFolderLink)}" target="_blank" rel="noopener noreferrer" class="text-app-blue hover:underline font-semibold">Open folder ↗</a>` : `<span class="text-gray-300">—</span>`;
        return `<tr class="hover:bg-blue-50/40">
          <td class="px-5 py-4"><p class="font-semibold text-gray-900">${escapeHtml(r.clientName || "—")}</p><p class="text-xs text-gray-400 mt-1">${escapeHtml(r.clientId || r.complianceId || "")}</p></td>
          <td class="px-5 py-4"><p class="font-semibold text-gray-800">${escapeHtml(r.complianceName || "—")}</p><p class="text-xs text-gray-400 mt-1">${escapeHtml(r.complianceAknNumber || "")}</p></td>
          <td class="px-5 py-4 text-gray-600">${escapeHtml(r.CompliancePeriod || "—")}</td>
          <td class="px-5 py-4 text-gray-600 whitespace-nowrap">${formatDate(r.dueDate)}</td>
          <td class="px-5 py-4">${pill(status)}</td>
          <td class="px-5 py-4">${paymentPill(r.paymentStatus)}</td>
          <td class="px-5 py-4 text-gray-600">${escapeHtml(r.priority || "—")}</td>
          <td class="px-5 py-4">${folder}</td>
        </tr>`;
      }).join("");
      if (!filtered.length) $("complianceRows").innerHTML = "";
    }

    function updateSummary() {
      const total = allRecords.length;
      const completed = allRecords.filter(r => recordStatus(r) === "completed").length;
      const overdue = allRecords.filter(r => recordStatus(r) === "overdue").length;
      const pending = allRecords.filter(r => recordStatus(r) === "pending").length;
      const now = new Date(); now.setHours(0,0,0,0);
      const nextWeek = new Date(now); nextWeek.setDate(nextWeek.getDate() + 7);
      const dueSoon = allRecords.filter(r => {
        if (filed(r)) return false;
        const due = toDate(r.dueDate);
        if (!due) return false;
        due.setHours(0,0,0,0);
        return due >= now && due <= nextWeek;
      }).length;
      const unpaid = allRecords.filter(r => ["unpaid","pending"].includes(normalize(r.paymentStatus))).length;

      $("totalCount").textContent = total.toLocaleString("en-IN");
      $("completedCount").textContent = completed.toLocaleString("en-IN");
      $("pendingCount").textContent = pending.toLocaleString("en-IN");
      $("overdueCount").textContent = overdue.toLocaleString("en-IN");
      $("dueSoonCount").textContent = dueSoon.toLocaleString("en-IN");
      $("unpaidCount").textContent = unpaid.toLocaleString("en-IN");
      $("clientCount").textContent = clientIds.size.toLocaleString("en-IN");
    }

    async function loadDashboard() {
      $("loadError").classList.add("hidden");
      $("complianceRows").innerHTML = `<tr><td colspan="8" class="px-5 py-12 text-center"><div class="flex justify-center"><div class="spinner"></div></div><p class="text-gray-400 mt-3">Loading compliance records...</p></td></tr>`;
      try {
        const [complianceSnap, clientsSnap] = await Promise.all([
          getDocs(collection(db, "compliance")),
          getDocs(collection(db, "clients"))
        ]);
        allRecords = complianceSnap.docs.map(doc => ({ firestoreDocId: doc.id, ...doc.data() }));
        clientIds = new Set(allRecords.map(r => r.clientId).filter(Boolean));

        // Populate distinct compliance periods using the existing field.
        const periods = [...new Set(allRecords.map(r => String(r.CompliancePeriod ?? "").trim()).filter(Boolean))].sort().reverse();
        $("periodFilter").innerHTML = `<option value="">All periods</option>` + periods.map(p => `<option value="${escapeHtml(p)}">${escapeHtml(p)}</option>`).join("");

        // Use actual client collection count if available, otherwise distinct linked client IDs.
        $("clientCount").textContent = (clientsSnap.size || clientIds.size).toLocaleString("en-IN");
        updateSummary();
        render();
        $("connectionState").innerHTML = `<span class="w-2 h-2 rounded-full bg-green-500"></span> Live data loaded`;
      } catch (error) {
        console.error("Firestore load failed:", error);
        $("complianceRows").innerHTML = "";
        $("loadError").textContent = `Could not load Firestore data (${error.code || "error"}). Check that Firestore rules allow this signed-in admin to read the compliance and clients collections.`;
        $("loadError").classList.remove("hidden");
      }
    }

    $("loginForm").addEventListener("submit", async (event) => {
      event.preventDefault();
      $("authError").classList.add("hidden");
      const email = normalize($("email").value);
      if (email !== ALLOWED_ADMIN_EMAIL) {
        showAuthError("Access denied. Only the authorized administrator can sign in here.");
        return;
      }
      $("loginButton").disabled = true;
      $("loginButton").textContent = "Signing in...";
      try {
        await signInWithEmailAndPassword(auth, email, $("password").value);
      } catch (error) {
        showAuthError(error.code === "auth/invalid-credential" ? "Incorrect email or password." : (error.message || "Sign-in failed."));
      } finally {
        $("loginButton").disabled = false;
        $("loginButton").textContent = "Sign in securely";
      }
    });

    document.querySelectorAll("[data-signout]").forEach(btn => btn.addEventListener("click", () => signOut(auth)));
    $("refreshButton").addEventListener("click", loadDashboard);
    ["searchInput","statusFilter","periodFilter","paymentFilter"].forEach(id => $(id).addEventListener(id === "searchInput" ? "input" : "change", render));

    onAuthStateChanged(auth, async (user) => {
      if (!user) {
        $("appShell").classList.add("hidden");
        $("authGate").classList.remove("hidden");
        return;
      }
      if (normalize(user.email) !== ALLOWED_ADMIN_EMAIL) {
        await signOut(auth);
        $("appShell").classList.add("hidden");
        $("authGate").classList.remove("hidden");
        showAuthError("Access denied. This account is not authorized.");
        return;
      }
      $("authGate").classList.add("hidden");
      $("appShell").classList.remove("hidden");
      $("userEmail").textContent = user.email;
      await loadDashboard();
    });
  </script>
</body>
</html>
