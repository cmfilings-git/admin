          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>
          Sign out
        </button>
      </div>
    </aside>

    <div class="flex-grow flex flex-col min-h-screen md:ml-64 w-full md:w-[calc(100%-16rem)]">
      <nav class="bg-white shadow-sm border-b border-gray-100 sticky top-0 z-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between h-16 sm:h-20 items-center">
            <div class="flex items-center gap-3">
              <img src="assets/logo.png" alt="Logo" class="h-11 w-11 object-contain md:hidden" onerror="this.style.display='none'">
              <img src="assets/name.png" alt="CM Filings" class="h-10 w-32 object-contain md:hidden" onerror="this.style.display='none'">
              <span class="hidden md:block text-base font-semibold text-gray-500">Compliance Management</span>
            </div>
            <div class="flex items-center gap-3 sm:gap-4">
              <span id="connectionState" class="hidden sm:inline-flex items-center gap-2 text-sm text-gray-500"><span class="w-2 h-2 rounded-full bg-green-500"></span> Connected</span>
              <div class="text-right">
                <p class="text-sm font-semibold text-gray-800" id="userEmail">shanicm@gmail.com</p>
                <p class="text-xs text-gray-400">Administrator</p>
              </div>
              <button data-signout class="md:hidden text-gray-500 p-2 rounded-lg hover:bg-gray-100" aria-label="Sign out">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/></svg>
              </button>
            </div>
          </div>
        </div>
      </nav>

      <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-10 pb-28 w-full">
        <header class="mb-6 md:mb-9">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-8 h-8 md:w-11 md:h-11 text-app-blue"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z"/></svg>
                <h1 class="text-3xl md:text-5xl font-bold text-gray-900">Compliance</h1>
              </div>
              <p class="text-gray-500 mt-2 text-base md:text-xl">Monitor client filings, deadlines and payment status.</p>
            </div>
            <button id="refreshButton" class="inline-flex items-center gap-2 bg-white border border-gray-200 text-gray-700 font-semibold px-4 py-3 rounded-xl hover:bg-gray-50 transition-colors">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h5M20 20v-5h-5M5.5 9A7 7 0 0118 6l2 3M18.5 15A7 7 0 016 18l-2-3"/></svg>
              Refresh
            </button>
          </div>
        </header>

        <div id="loadError" class="hidden mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>

        <!-- KPI cards -->
        <section class="grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-5 mb-7">
          <article class="bg-app-blue rounded-2xl md:rounded-[2rem] p-4 md:p-6 shadow-lg shadow-app-blue/20">
            <div class="flex justify-between items-start"><p class="text-white/90 text-sm md:text-base">Total compliances</p><span class="text-app-cyan"><svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5h6m-7 4h8m-8 4h8m-8 4h5M6 3h12a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V5a2 2 0 012-2z"/></svg></span></div>
            <p id="totalCount" class="text-white text-3xl md:text-4xl font-bold mt-3">—</p>
            <p class="text-white/75 text-xs mt-1">All records</p>
          </article>
          <article class="bg-white border-2 border-gray-100 rounded-2xl md:rounded-[2rem] p-4 md:p-6 shadow-sm">
            <div class="flex justify-between items-start"><p class="text-gray-500 text-sm md:text-base">Completed</p><span class="text-green-600"><svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></span></div>
            <p id="completedCount" class="text-gray-900 text-3xl md:text-4xl font-bold mt-3">—</p>
            <p class="text-gray-400 text-xs mt-1">Filed / completed</p>
          </article>
          <article class="bg-white border-2 border-gray-100 rounded-2xl md:rounded-[2rem] p-4 md:p-6 shadow-sm">
            <div class="flex justify-between items-start"><p class="text-gray-500 text-sm md:text-base">Pending</p><span class="text-yellow-600"><svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"/></svg></span></div>
            <p id="pendingCount" class="text-gray-900 text-3xl md:text-4xl font-bold mt-3">—</p>
            <p class="text-gray-400 text-xs mt-1">Awaiting action</p>
          </article>
          <article class="bg-app-blue rounded-2xl md:rounded-[2rem] p-4 md:p-6 shadow-lg shadow-app-blue/20">
            <div class="flex justify-between items-start"><p class="text-white/90 text-sm md:text-base">Overdue</p><span class="text-app-cyan"><svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.86L2.8 17a2 2 0 001.74 3h14.92a2 2 0 001.74-3l-7.5-13.14a2 2 0 00-3.48 0z"/></svg></span></div>
            <p id="overdueCount" class="text-white text-3xl md:text-4xl font-bold mt-3">—</p>
            <p class="text-white/75 text-xs mt-1">Past due date and not filed</p>
          </article>
        </section>

        <!-- Summary strip -->
        <section class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-5 mb-8">
          <div class="bg-white border-2 border-gray-100 rounded-2xl p-5 shadow-sm">
            <p class="text-gray-500 text-sm">Due in next 7 days</p><p id="dueSoonCount" class="text-2xl font-bold text-gray-900 mt-1">—</p>
          </div>
          <div class="bg-white border-2 border-gray-100 rounded-2xl p-5 shadow-sm">
            <p class="text-gray-500 text-sm">Payment unpaid / pending</p><p id="unpaidCount" class="text-2xl font-bold text-gray-900 mt-1">—</p>
          </div>
          <div class="bg-white border-2 border-gray-100 rounded-2xl p-5 shadow-sm">
            <p class="text-gray-500 text-sm">Clients with compliance records</p><p id="clientCount" class="text-2xl font-bold text-gray-900 mt-1">—</p>
          </div>
        </section>

        <!-- Register -->
        <section class="bg-white border-2 border-gray-100 rounded-[1.5rem] md:rounded-[2rem] shadow-sm overflow-hidden">
          <div class="p-5 md:p-7 border-b border-gray-100">
            <div class="flex flex-wrap justify-between items-center gap-3 mb-5">
              <div><h2 class="text-gray-900 text-xl md:text-2xl font-bold">Compliance register</h2><p class="text-gray-400 text-sm mt-1">Live records from Firestore · compliance</p></div>
              <span id="recordCount" class="text-sm text-gray-500">0 records</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">
              <input id="searchInput" type="search" placeholder="Search client, ID, compliance..." class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm outline-none focus:border-app-blue focus:ring-2 focus:ring-blue-100">
              <select id="statusFilter" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-gray-700 bg-white outline-none focus:border-app-blue"><option value="">All statuses</option><option value="completed">Completed</option><option value="pending">Pending</option><option value="overdue">Overdue</option></select>
              <select id="periodFilter" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-gray-700 bg-white outline-none focus:border-app-blue"><option value="">All periods</option></select>
              <select id="paymentFilter" class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-gray-700 bg-white outline-none focus:border-app-blue"><option value="">All payment statuses</option><option value="paid">Paid</option><option value="unpaid">Unpaid</option><option value="pending">Pending</option></select>
            </div>
          </div>
          <div class="table-scroll">
            <table class="min-w-[900px] w-full text-left">
              <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
                <tr>
                  <th class="px-5 py-4 font-semibold">Client / ID</th>
                  <th class="px-5 py-4 font-semibold">Compliance</th>
                  <th class="px-5 py-4 font-semibold">Period</th>
                  <th class="px-5 py-4 font-semibold">Due date</th>
                  <th class="px-5 py-4 font-semibold">Filing status</th>
                  <th class="px-5 py-4 font-semibold">Payment</th>
                  <th class="px-5 py-4 font-semibold">Priority</th>
                  <th class="px-5 py-4 font-semibold">Folder</th>
                </tr>
              </thead>
              <tbody id="complianceRows" class="divide-y divide-gray-100 text-sm">
                <tr><td colspan="8" class="px-5 py-12 text-center"><div class="flex justify-center"><div class="spinner"></div></div><p class="text-gray-400 mt-3">Loading compliance records...</p></td></tr>
              </tbody>
            </table>
          </div>
          <div id="emptyState" class="hidden px-5 py-12 text-center text-gray-400">No compliance records match your filters.</div>
          <div class="px-5 py-4 bg-gray-50 border-t border-gray-100 text-xs text-gray-400">Status is calculated from your existing complianceStatus, filedAt and dueDate fields. No Firestore records are modified.</div>
        </section>
      </main>
    </div>

    <!-- Mobile bottom navigation -->
    <nav class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 shadow-[0_-4px_20px_rgba(0,0,0,0.05)] z-50 md:hidden">
      <div class="flex justify-around items-center h-20 max-w-md mx-auto px-2">
