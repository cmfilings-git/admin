<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#F8FAFC">
  <title>CM Filings | Compliance Dashboard</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Outfit', 'sans-serif'] },
          colors: {
            'app-blue': '#2F74FF',
            'app-cyan': '#3EE3D3',
            'app-bg': '#F8FAFC'
          }
        }
      }
    };
  </script>
  <style>
    body { font-family: 'Outfit', sans-serif; }
    .spinner { width: 22px; height: 22px; border: 3px solid #dbeafe; border-top-color: #2F74FF; border-radius: 50%; animation: spin .8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .status-pill { display:inline-flex; align-items:center; border-radius:9999px; padding:4px 10px; font-size:12px; font-weight:600; white-space:nowrap; }
    .status-complete { color:#15803d; background:#f0fdf4; border:1px solid #dcfce7; }
    .status-pending { color:#a16207; background:#fefce8; border:1px solid #fef08a; }
    .status-overdue { color:#b91c1c; background:#fef2f2; border:1px solid #fee2e2; }
    .status-other { color:#475569; background:#f1f5f9; border:1px solid #e2e8f0; }
    .table-scroll { overflow-x:auto; -webkit-overflow-scrolling:touch; }
    .nav-active { color:#2F74FF; background:#eff6ff; }
    button:disabled { opacity:.55; cursor:not-allowed; }
  </style>
</head>

<body class="bg-app-bg font-sans min-h-screen flex flex-col">
  <!-- Authentication gate -->
  <section id="authGate" class="fixed inset-0 z-[100] bg-app-bg flex items-center justify-center p-5">
    <div class="w-full max-w-md bg-white border border-gray-100 rounded-3xl shadow-xl p-7 sm:p-9">
      <div class="flex items-center gap-3 mb-8">
        <img src="assets/logo.png" alt="CM Filings" class="h-12 w-12 object-contain" onerror="this.style.display='none'">
        <img src="assets/name.png" alt="CM Filings" class="h-10 w-36 object-contain" onerror="this.style.display='none'">
      </div>
      <div class="w-14 h-14 rounded-2xl bg-blue-50 text-app-blue flex items-center justify-center mb-5">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-7a2 2 0 00-2-2H6a2 2 0 00-2 2v7a2 2 0 002 2zm2-11V7a4 4 0 118 0v3"/></svg>
      </div>
      <h1 class="text-3xl font-bold text-gray-900">Admin sign in</h1>
      <p class="text-gray-500 mt-2">Sign in with the authorized CM Filings administrator account.</p>
      <form id="loginForm" class="mt-7 space-y-4">
        <div>
          <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email address</label>
          <input id="email" type="email" autocomplete="username" required value="shanicm@gmail.com"
            class="w-full rounded-xl border border-gray-200 px-4 py-3.5 text-gray-900 outline-none focus:border-app-blue focus:ring-2 focus:ring-blue-100">
        </div>
        <div>
          <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">Password</label>
          <input id="password" type="password" autocomplete="current-password" required
            class="w-full rounded-xl border border-gray-200 px-4 py-3.5 text-gray-900 outline-none focus:border-app-blue focus:ring-2 focus:ring-blue-100" placeholder="Enter admin password">
        </div>
        <p id="authError" class="hidden text-sm text-red-600" role="alert"></p>
        <button id="loginButton" type="submit" class="w-full bg-app-blue text-white font-semibold rounded-xl py-3.5 shadow-lg shadow-app-blue/20 hover:bg-blue-700 transition-colors">Sign in securely</button>
      </form>
      <p class="text-xs text-gray-400 mt-6">Authorized account: shanicm@gmail.com</p>
    </div>
  </section>

  <div id="appShell" class="hidden">
