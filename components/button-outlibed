<!-- cb-outlined-button.html | Reusable COREBIQ Material 3 Outlined Button
     Copy the <style> and <script> sections once per page/app, 
     then use the <button> markup wherever needed.
     (Note: If you already have the base .cb-btn class from the primary button, 
     you only need to add the .cb-btn-outlined specific classes!)
-->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>COREBIQ Outlined Button</title>
<!-- Tailwind for layout utilities in this demo -->
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20,500,0,0" rel="stylesheet" />

<!-- ==========================================
     BEGIN COMPONENT REQUIRED CSS
     ========================================== -->
<style>
  :root {
    /* Outlined Button Colors (Light Mode) */
    --cb-outline-border: #cbd5e1;       /* Slate 300 */
    --cb-outline-text: #334155;         /* Slate 700 */
    --cb-outline-hover-bg: #f8fafc;     /* Slate 50 */
    --cb-outline-active-bg: #f1f5f9;    /* Slate 100 */
    
    /* Disabled States */
    --cb-disabled-border: #e2e8f0;      /* Slate 200 */
    --cb-disabled-text: #94a3b8;        /* Slate 400 */
  }

  /* Base Button Class (Shared with Primary/Secondary) */
  .cb-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 40px;
    padding: 0 24px;
    border-radius: 9999px; /* Fully rounded/pill */
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.1px;
    cursor: pointer;
    overflow: hidden; /* For ripple containment */
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
    box-sizing: border-box;
  }

  /* Outlined Variant */
  .cb-btn-outlined {
    background-color: transparent;
    color: var(--cb-outline-text);
    border: 1px solid var(--cb-outline-border);
  }

  .cb-btn-outlined:hover:not(:disabled) {
    background-color: var(--cb-outline-hover-bg);
  }

  .cb-btn-outlined:active:not(:disabled) {
    background-color: var(--cb-outline-active-bg);
    transform: scale(0.98);
  }

  .cb-btn:focus-visible {
    outline: 2px solid var(--cb-outline-text);
    outline-offset: 2px;
  }

  /* Disabled State */
  .cb-btn-outlined:disabled {
    border-color: var(--cb-disabled-border);
    color: var(--cb-disabled-text);
    background-color: transparent;
    cursor: not-allowed;
  }

  /* Icon styling inside button */
  .cb-btn svg, .cb-btn .material-symbols-rounded {
    width: 18px;
    height: 18px;
    font-size: 18px;
    flex-shrink: 0;
  }

  /* Ripple Effect CSS (Slate/Gray for outlined button) */
  .cb-ripple {
    position: absolute;
    border-radius: 50%;
    transform: scale(0);
    animation: cb-ripple-animation 600ms linear;
    background-color: rgba(51, 65, 85, 0.1); /* Slate 700 with low opacity */
    pointer-events: none;
  }

  @keyframes cb-ripple-animation {
    to {
      transform: scale(4);
      opacity: 0;
    }
  }

  /* Loading Spinner (Matched to text color) */
  .cb-btn-loader {
    display: none;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(51, 65, 85, 0.2);
    border-radius: 50%;
    border-top-color: var(--cb-outline-text);
    animation: cb-spin 0.8s linear infinite;
    position: absolute;
  }
  
  .cb-btn-outlined.is-loading {
    color: transparent !important;
    pointer-events: none;
  }
  
  .cb-btn-outlined.is-loading .cb-btn-loader {
    display: block;
  }
  
  @keyframes cb-spin {
    to { transform: rotate(360deg); }
  }

  /* Dark Mode Support */
  @media (prefers-color-scheme: dark) {
    :root {
      --cb-outline-border: #475569;       /* Slate 600 */
      --cb-outline-text: #e2e8f0;         /* Slate 200 */
      --cb-outline-hover-bg: rgba(71, 85, 105, 0.2); /* Slate 600 transparent */
      --cb-outline-active-bg: rgba(71, 85, 105, 0.4);
      
      --cb-disabled-border: #334155;
      --cb-disabled-text: #64748b;
    }
    .cb-ripple {
      background-color: rgba(255, 255, 255, 0.1);
    }
    .cb-btn-loader {
      border: 2px solid rgba(226, 232, 240, 0.2);
      border-top-color: var(--cb-outline-text);
    }
  }
</style>
<!-- ==========================================
     END COMPONENT REQUIRED CSS
     ========================================== -->
</head>
<body class="bg-slate-50 dark:bg-slate-900 p-12 flex flex-col gap-8 items-start">

  <div>
    <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">1. Standard Outlined Button</h3>
    <!-- COPY THIS HTML -->
    <button type="button" class="cb-btn cb-btn-outlined">
      Cancel
    </button>
  </div>

  <div>
    <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">2. With Leading Icon</h3>
    <!-- COPY THIS HTML -->
    <button type="button" class="cb-btn cb-btn-outlined">
      <span class="material-symbols-rounded">download</span>
      Export Data
    </button>
  </div>

  <div>
    <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">3. Disabled State</h3>
    <!-- COPY THIS HTML -->
    <button type="button" class="cb-btn cb-btn-outlined" disabled>
      <span class="material-symbols-rounded">cloud_off</span>
      Offline
    </button>
  </div>

  <div>
    <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">4. Loading State (Click to demo)</h3>
    <!-- COPY THIS HTML -->
    <button type="button" class="cb-btn cb-btn-outlined" id="demo-load-btn" onclick="toggleLoading(this)">
      <div class="cb-btn-loader"></div>
      <span>Load More</span>
    </button>
  </div>

<!-- ==========================================
     BEGIN COMPONENT REQUIRED JS (Ripple Logic)
     ========================================== -->
<script>
  function createRipple(event) {
    const button = event.currentTarget;
    
    // Prevent ripple if disabled or loading
    if (button.disabled || button.classList.contains('is-loading')) return;

    const circle = document.createElement("span");
    const diameter = Math.max(button.clientWidth, button.clientHeight);
    const radius = diameter / 2;

    const rect = button.getBoundingClientRect();
    
    // Calculate click coordinates relative to button
    let clientX = event.clientX;
    let clientY = event.clientY;
    
    // Handle touch events
    if (event.type === 'touchstart') {
        clientX = event.touches[0].clientX;
        clientY = event.touches[0].clientY;
    }

    circle.style.width = circle.style.height = `${diameter}px`;
    circle.style.left = `${clientX - rect.left - radius}px`;
    circle.style.top = `${clientY - rect.top - radius}px`;
    circle.classList.add("cb-ripple");

    // Remove existing ripple
    const existingRipple = button.querySelector(".cb-ripple");
    if (existingRipple) {
      existingRipple.remove();
    }

    button.appendChild(circle);
  }

  // Attach ripple to all cb-btns
  function initButtons() {
    const buttons = document.querySelectorAll('.cb-btn');
    for (const button of buttons) {
      button.addEventListener("mousedown", createRipple);
      button.addEventListener("touchstart", createRipple, { passive: true });
    }
  }

  // Run on load
  document.addEventListener('DOMContentLoaded', initButtons);

  /* --- Demo utility for loading state --- */
  function toggleLoading(btn) {
    btn.classList.add('is-loading');
    setTimeout(() => {
        btn.classList.remove('is-loading');
    }, 2000);
  }
</script>
<!-- ==========================================
     END COMPONENT REQUIRED JS
     ========================================== -->
</body>
</html>
